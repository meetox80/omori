.fvec projection[4]
.fvec texscale

.constf base(0.0, 0.0, 0.0, 1.0)
.constf inv255(0.00392156862745, 0.00392156862745, 0.00392156862745, 0.00392156862745)

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intc v1
.alias inclr v2

.proc main
	mov r0, base
	mov r0.xy, inpos
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mul outtc0, texscale, intc
	mul outclr, inv255, inclr
	end
.end
