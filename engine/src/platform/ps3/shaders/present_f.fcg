float4 main(float2 vTexcoord : TEXCOORD0, float4 vExtra : TEXCOORD1, uniform sampler2D uTexture : TEXUNIT0) : COLOR
{
    float2 texel = vTexcoord * vExtra.xy;
    float2 base = floor(texel);
    float2 d = texel - base - 0.5;
    float r = 0.5 - 0.5 / vExtra.z;
    float2 f = (d - clamp(d, -r, r)) * vExtra.z + 0.5;
    return float4(tex2D(uTexture, (base + f) / vExtra.xy).rgb, 1.0);
}
