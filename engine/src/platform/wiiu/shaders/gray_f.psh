; $MODE = "UniformRegister"
; $SAMPLER_VARS[0].name = "uTexture"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0
; $NUM_SPI_PS_INPUT_CNTL = 2
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 2
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1

00 TEX:
   0  SAMPLE R0, R0.xy0x, t0, s0
01 ALU:
   1  x: ADD R2.x, R0.x, R0.y
   2  x: ADD R2.x, PV1.x, R0.z
   3  x: MUL R2.x, PV2.x, 0.33333334f
   4  x: ADD R3.x, PV3.x, -R0.x
      y: ADD R3.y, PV3.x, -R0.y
      z: ADD R3.z, PV3.x, -R0.z
   5  x: MULADD R0.x, PV4.x, R1.x, R0.x
      y: MULADD R0.y, PV4.y, R1.x, R0.y
      z: MULADD R0.z, PV4.z, R1.x, R0.z
02 EXP_DONE: PIX0, R0.xyz1
END_OF_PROGRAM
