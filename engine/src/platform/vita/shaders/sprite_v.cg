void main(float2 aPosition,
          float2 aTexcoord,
          float4 aColor,
          uniform float4 uTransform,
          out float4 vPosition : POSITION,
          out float2 vTexcoord : TEXCOORD0,
          out float4 vColor : COLOR0)
{
    vPosition = float4(aPosition * uTransform.xy + uTransform.zw, 0.5, 1.0);
    vTexcoord = aTexcoord;
    vColor = aColor;
}
