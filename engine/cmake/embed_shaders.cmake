set(body "#include \"common/embedded_shaders.h\"\n\n#include <cstring>\n\n")
set(table "")
string(REPLACE "|" ";" IN "${IN}")
foreach(path ${IN})
  get_filename_component(name "${path}" NAME_WE)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" len)
  math(EXPR size "${len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND body "alignas(16) static const unsigned char shader_${name}[] = {${bytes}};\n")
  string(APPEND table "    {\"${name}\", shader_${name}, ${size}},\n")
endforeach()
string(APPEND body "\nstatic const EmbeddedShader shaders[] = {\n${table}};\n\n")
string(APPEND body "const EmbeddedShader* embedded_shader(const char* name) {\n    for (const EmbeddedShader& s : shaders) {\n        if (std::strcmp(s.name, name) == 0) return &s;\n    }\n    return nullptr;\n}\n")
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL body)
  file(WRITE "${OUT}" "${body}")
endif()
